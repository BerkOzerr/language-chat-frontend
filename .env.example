# Development: leave blank to use the Vite /api proxy to localhost:3000.
# Production: set this to the deployed API origin, e.g. https://api.example.com
VITE_API_BASE_URL=
# Optional. In development the WebSocket uses the Vite proxy automatically.
# In production, set e.g. wss://api.example.com/ws
VITE_WS_URL=
